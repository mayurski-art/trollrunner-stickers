# Copy this file to .env and fill in real values. Never commit .env.
# These are used by the AI custom-sticker generator's backend proxy (Feature 2),
# NOT by the static site. The browser must never see these values.

# xAI Grok image API key (https://x.ai). Server-side only.
# The backend proxies all generation requests so users don't need their own key.
XAI_API_KEY=

# Optional: override the xAI base URL (OpenAI-compatible endpoint).
# XAI_BASE_URL=https://api.x.ai/v1
